    <Reference Include="System.IO.Compression"><HintPath>$(SLManaged)\System.IO.Compression.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Memory"><HintPath>$(SLManaged)\System.Memory.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http"><HintPath>$(SLManaged)\System.Net.Http.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Numerics"><HintPath>$(SLManaged)\System.Numerics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime"><HintPath>$(SLManaged)\System.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>$(SLManaged)\System.Runtime.CompilerServices.Unsafe.dll</HintPath><Private>false</Private></Reference>
