<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RadioLightPlugin (EXILED 9 / LabAPI, SCP: Secret Laboratory 14.2)
    Referencias: copiá las DLL que se listan en lib/README.md a la carpeta lib/
    (o pasá otras rutas con: dotnet build -c Release -p:SLManaged=RUTA -p:SLLibs=RUTA).
  -->
  <PropertyGroup>
    <AssemblyName>RadioLightPlugin</AssemblyName>
    <RootNamespace>RadioLightPlugin</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Nullable>disable</Nullable>
    <SLManaged Condition="'$(SLManaged)' == ''">$(MSBuildThisFileDirectory)lib\Managed</SLManaged>
    <SLLibs Condition="'$(SLLibs)' == ''">$(MSBuildThisFileDirectory)lib</SLLibs>
    <!-- se compila contra las librerías del propio juego (Mono), no contra .NET Framework -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <FrameworkPathOverride>$(SLManaged)</FrameworkPathOverride>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <AssemblySearchPaths>{HintPathFromItem};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- hace públicos los miembros privados del juego al compilar (el plugin usa algunos) -->
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp;Assembly-CSharp-firstpass;LabApi;Mirror" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup Label="Juego (SCPSL_Data/Managed)">
    <Reference Include="Assembly-CSharp"><HintPath>$(SLManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(SLManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommandSystem.Core"><HintPath>$(SLManaged)\CommandSystem.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LabApi"><HintPath>$(SLManaged)\LabApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(SLManaged)\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror.Components"><HintPath>$(SLManaged)\Mirror.Components.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NorthwoodLib"><HintPath>$(SLManaged)\NorthwoodLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pooling"><HintPath>$(SLManaged)\Pooling.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(SLManaged)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Buffers"><HintPath>$(SLManaged)\System.Buffers.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.ComponentModel.Composition"><HintPath>$(SLManaged)\System.ComponentModel.Composition.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Configuration"><HintPath>$(SLManaged)\System.Configuration.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(SLManaged)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Data"><HintPath>$(SLManaged)\System.Data.dll</HintPath><Private>false</Private></Reference>
